{
  "name": "buzz-off",
  "version": "1.0.0",
  "description": "A daily word puzzle: how many words can you make with 7 letters?",
  "author": "",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npx jest --json --outputFile=jest-results.json",
    "build": "tsc --noEmit && webpack --config webpack.config.js",
    "start": "webpack serve --config webpack.config.js",
    "lint": "eslint \"src/typescript/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.ts\" -f json -o eslint-results.json",
    "lint:fix": "eslint \"src/typescript/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.ts\" -f json -o eslint-results.json --fix",
    "build:words": "node tools/run.cjs tools/build-wordlist.ts",
    "build:icons": "node tools/run.cjs tools/make-icons.ts"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "html-webpack-plugin": "^5.6.5",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "mini-css-extract-plugin": "^2.9.4",
    "prettier": "^3.7.4",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
